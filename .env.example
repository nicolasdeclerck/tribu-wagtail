# Copy to .env and adjust. NEVER commit the real .env.
#   cp .env.example .env

# --- Traefik ------------------------------------------------------------
# Domaine principal (l'apex + www sont routés par les labels du service nginx).
DOMAIN=latribudoya.fr

# --- Django -------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=latribudoya.fr,www.latribudoya.fr,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://latribudoya.fr,https://www.latribudoya.fr
WAGTAILADMIN_BASE_URL=https://latribudoya.fr
# TLS terminé par Traefik en amont → on active le durcissement HTTPS
# (redirection, cookies sécurisés, HSTS). nginx propage X-Forwarded-Proto.
DJANGO_SECURE_SSL_REDIRECT=true

# --- Plausible Analytics (optionnel) ------------------------------------
# Mesure d'audience via l'instance Plausible auto-hébergée (la même que
# Culturall). Laisser les deux vides pour désactiver. PLAUSIBLE_SCRIPT_URL
# pointe vers le script servi par l'instance (ex. https://stats.example.com/js/script.js).
PLAUSIBLE_DOMAIN=latribudoya.fr
PLAUSIBLE_SCRIPT_URL=

# --- Cloudflare Turnstile (optionnel) -----------------------------------
# Anti-bots du formulaire de contact. Créer un widget sur
# https://dash.cloudflare.com/ → Turnstile, avec le domaine latribudoya.fr.
# Laisser vide pour désactiver la vérification (dev, tests, CI).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (Gmail SMTP) -------------------------------------------------
# Envoi des messages du formulaire de contact. Laisser EMAIL_HOST vide pour
# ne rien envoyer (les mails sont alors seulement écrits dans les logs).
# EMAIL_HOST_PASSWORD = « mot de passe d'application » Google (16 caractères,
# sans espaces), PAS le mot de passe du compte. Cf. README › Envoi des emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=compte@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="La tribu d'Oya <compte@gmail.com>"

# --- Database (keep POSTGRES_* and DATABASE_URL consistent) -------------
POSTGRES_DB=tribu
POSTGRES_USER=tribu
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://tribu:change-me@db:5432/tribu

# --- First boot helpers (optional) -------------------------------------
# Seed the legacy content automatically on first container start.
SEED_CONTENT=1
# Auto-create an admin (leave blank to create it manually later).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@latribudoya.fr
DJANGO_SUPERUSER_PASSWORD=change-me-too
